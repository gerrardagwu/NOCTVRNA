# Copy to .env.local for local development (never commit real values).
# In production these live in Vercel → Project → Settings → Environment Variables.

# Brevo → SMTP & API → API keys. Needs access to Contacts and Transactional emails.
BREVO_API_KEY=
# Brevo → Contacts → Lists: the numeric ID of the waitlist list.
BREVO_LIST_ID=
# A sender verified in Brevo, on the thisisnoctvrna.com domain (Brevo → Senders, domains & dedicated IPs).
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NOCTVRNA

# Optional: the public site address used for links and images in the confirmation email.
# Defaults to https://thisisnoctvrna.com.
# SITE_URL=
